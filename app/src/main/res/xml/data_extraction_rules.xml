<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+ backup / device-transfer rules. Only the listed paths are included;
     SharedPreferences (Keystore-encrypted OAuth tokens) are never backed up. -->
<data-extraction-rules>
    <cloud-backup>
        <include domain="database" path="yadino.db" />
        <include domain="database" path="yadino.db-wal" />
        <include domain="file" path="datastore/" />
    </cloud-backup>
    <device-transfer>
        <include domain="database" path="yadino.db" />
        <include domain="database" path="yadino.db-wal" />
        <include domain="file" path="datastore/" />
    </device-transfer>
</data-extraction-rules>
