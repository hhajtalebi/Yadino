<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Base window theme. All UI is drawn with Jetpack Compose (Material 3). -->
    <style name="Theme.Yadino" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@color/yadino_cream</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:fontFamily">@font/vazirmatn</item>
        <item name="android:colorAccent">@color/yadino_green</item>
    </style>

    <!-- Dialog-like activity for quick note capture from the widget/shortcut -->
    <style name="Theme.Yadino.Dialog" parent="android:Theme.Material.Light.Dialog.NoActionBar">
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowIsTranslucent">true</item>
        <item name="android:backgroundDimEnabled">true</item>
        <item name="android:fontFamily">@font/vazirmatn</item>
        <item name="android:colorAccent">@color/yadino_green</item>
        <item name="android:windowMinWidthMajor">90%</item>
        <item name="android:windowMinWidthMinor">90%</item>
    </style>
</resources>
