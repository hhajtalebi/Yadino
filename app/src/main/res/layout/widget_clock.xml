<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:layoutDirection="rtl"
    tools:ignore="HardcodedText">

    <ImageView
        android:id="@+id/widget_bg"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="fitXY"
        android:src="@drawable/widget_bg"
        android:importantForAccessibility="no" />
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="10dp">
        <TextClock
            android:id="@+id/w_clock"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/vazirmatn"
            android:format12Hour="h:mm"
            android:format24Hour="HH:mm"
            android:includeFontPadding="false"
            android:textColor="@color/widget_accent"
            android:textSize="46sp"
            android:textStyle="bold" />
    <TextView
        android:id="@+id/w_date"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="@font/vazirmatn"
        android:text="چهارشنبه ۲۲ مهر ۱۴۰۵"
        android:textColor="@color/widget_text"
        android:textSize="16sp"
        android:textStyle="normal"
        android:textDirection="rtl"
        android:gravity="center" />
    <TextView
        android:id="@+id/w_gregorian"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="@font/vazirmatn"
        android:text=""
        android:textColor="@color/widget_text_secondary"
        android:textSize="12sp"
        android:textStyle="normal"
        android:textDirection="rtl" />
    <TextView
        android:id="@+id/w_occasion"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="@font/vazirmatn"
        android:text=""
        android:textColor="@color/widget_text_secondary"
        android:textSize="12sp"
        android:textStyle="normal"
        android:textDirection="rtl"
        android:maxLines="2"
        android:ellipsize="end"
        android:gravity="center" />
    </LinearLayout>
</FrameLayout>
