<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:layoutDirection="rtl">

    <ImageView
        android:id="@+id/widget_bg"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="fitXY"
        android:src="@drawable/widget_bg"
        android:importantForAccessibility="no" />
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="12dp">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">
            <TextView
                android:id="@+id/w_title"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:fontFamily="@font/vazirmatn"
                android:text="یادداشت"
                android:textColor="@color/widget_text"
                android:textSize="15sp"
                android:textStyle="bold"
                android:textDirection="rtl"
                android:maxLines="1"
                android:ellipsize="end" />
            <ImageView
                android:id="@+id/w_add"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:padding="6dp"
                android:contentDescription="@string/widget_new_note"
                android:src="@drawable/ic_widget_add" />
        </LinearLayout>
        <LinearLayout
            android:id="@+id/w_body"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="vertical">
            <TextView
                android:id="@+id/w_content"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:fontFamily="@font/vazirmatn"
                android:text=""
                android:textColor="@color/widget_text_secondary"
                android:textSize="13sp"
                android:textStyle="normal"
                android:textDirection="rtl"
                android:ellipsize="end" />
            <TextView
                android:id="@+id/w_meta"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/vazirmatn"
                android:text=""
                android:textColor="@color/widget_text_secondary"
                android:textSize="10sp"
                android:textStyle="normal"
                android:textDirection="rtl" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
